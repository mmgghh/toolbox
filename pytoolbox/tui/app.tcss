Screen {
    background: $surface;
}

#search {
    dock: top;
}

#commands {
    height: 1fr;
}

#fields {
    height: 1fr;
    padding: 1 2;
}

.field {
    height: auto;
    margin-bottom: 1;
}

MultiInput {
    height: auto;
    margin-bottom: 1;
}

MultiInput > #values {
    height: auto;
}

MultiInput > #values > Horizontal {
    height: auto;
}

PathInput {
    height: auto;
}

PathInput > OptionList {
    height: auto;
    max-height: 8;
}

#preview {
    dock: bottom;
    height: auto;
    padding: 1 2;
    background: $panel;
    color: $success;
}

HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help-body {
    width: auto;
    max-width: 70;
    height: auto;
    border: round $primary;
    padding: 1 2;
    background: $panel;
}
